  "definitions": [
    {
      "name": "log_return_bps",
      "formula": "10000 * ln(close_t / close_(t-1))",
      "unit": "bps",
      "window_candles": 1,
      "requires": "previous grid candle closed and present"
    },
    {
      "name": "velocity_bps_5",
      "formula": "10000 * ln(close_t / close_(t-4))",
      "unit": "bps",
      "window_candles": 5,
      "requires": "contiguous run of 5 closed grid candles ending at t"
    },
    {
      "name": "rel_volume_10",
      "formula": "base_volume_t / mean(base_volume t-9..t-1)",
      "unit": "ratio",
      "window_candles": 10,
      "requires": "current base_volume and contiguous baseline of 10 closed candles with base_volume"
    },
    {
      "name": "vwap_typical_10",
      "formula": "sum(((h+l+c)/3 * v)) / sum(v) over t-9..t",
      "unit": "price (quote)",
      "window_candles": 10,
      "requires": "contiguous run of 10 closed candles with base_volume; approximation weighted by typical price, NOT the traded VWAP of market_structure.vwap_record"
    },
    {
      "name": "vwap_dev_bps_10",
      "formula": "10000 * (close_t / vwap_typical_10 - 1)",
      "unit": "bps",
      "window_candles": 10,
      "requires": "vwap_typical_10 of the same candle"
    }
  ],
